# Mirrors the WG_* variables of install-wg-easy.sh so the generated .env stays
# familiar and hand-editable.

# UI / TLS
WG_DOMAIN="{{ wg_easy_domain }}"
ACME_EMAIL="{{ wg_easy_acme_email | default('admin@' ~ wg_easy_domain, true) }}"
WG_TLS="{{ wg_easy_tls }}"

# WireGuard endpoint advertised to clients
WG_HOST="{{ wg_easy_host_final }}"
WG_PORT="{{ wg_easy_port }}"
WG_DNS="{{ wg_easy_dns }}"
WG_SUBNET="{{ wg_easy_subnet }}"

# wg-easy unattended first-run setup (v15)
WG_ADMIN_USER="{{ wg_easy_admin_user }}"
WG_ADMIN_PASSWORD="{{ wg_easy_admin_password_final }}"

# Images (pin the major tag; :latest is still v14)
WGE_IMAGE="{{ wg_easy_image }}"
CADDY_IMAGE="{{ wg_easy_caddy_image }}"
